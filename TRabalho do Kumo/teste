import tkinter as tk
import os
from tkinter import messagebox
import random
from PIL import Image, ImageTk

BASE_DIR = os.path.dirname(os.path.abspath(__file__))

def equipar_skin(parte, skin):
    skins_equipadas[parte] = skin
    atualizar_pet_visual()

def carregar_sprite(caminho):
    try:
        caminho_completo = os.path.join(BASE_DIR, caminho)
        imagem = Image.open(caminho_completo)
        imagem = imagem.resize((200, 200))
        return ImageTk.PhotoImage(imagem)
    except Exception as e:
        # Cria uma imagem transparente de segurança caso a pasta de sprites não esteja no local correto
        img_vazia = Image.new("RGBA", (200, 200), (0, 0, 0, 0))
        return ImageTk.PhotoImage(img_vazia)

# =====================
# JANELA PRINCIPAL (Deve ser criada antes de carregar as imagens!)
# =====================
janela = tk.Tk()
janela.title("Pet Game")
janela.geometry("400x650")
janela.configure(bg="#222222")

# =====================
# STATUS DO PET
# =====================
pet = {
    "nome": "Kumo",
    "fome": 100,
    "energia": 100,
    "felicidade": 100,
    "higiene": 100
}

# =====================
# BANCO DE SKINS
# =====================
skins = {
    "corpo": {
        "skin_corpo_1": carregar_sprite("sprites/corpo/corpo1.png"),
        "skin_corpo_2": carregar_sprite("sprites/corpo/corpo2.png"),
        "skin_corpo_3": carregar_sprite("sprites/corpo/corpo3.png")
    },
    "cabelo": {
        "skin_cabelo_1": carregar_sprite("sprites/cabelo/cabelo1.png"),
        "skin_cabelo_2": carregar_sprite("sprites/cabelo/cabelo2.png"),
        "skin_cabelo_3": carregar_sprite("sprites/cabelo/cabelo3.png")
    },
    "brasos": {
        "skin_brasos_1": carregar_sprite("sprites/brasos/brasos1.png"),
        "skin_brasos_2": carregar_sprite("sprites/brasos/brasos2.png"),
        "skin_brasos_3": carregar_sprite("sprites/brasos/brasos3.png")
    },
    "pernas": {
        "skin_pernas_1": carregar_sprite("sprites/pernas/pernas1.png"),
        "skin_pernas_2": carregar_sprite("sprites/pernas/pernas2.png"),
        "skin_pernas_3": carregar_sprite("sprites/pernas/pernas3.png")
    },
    "torso": {
        "skin_torso_1": carregar_sprite("sprites/torso/torso1.png"),
        "skin_torso_2": carregar_sprite("sprites/torso/torso2.png"),
        "skin_torso_3": carregar_sprite("sprites/torso/torso3.png")
    },
    "olhos": {
        "abertos": carregar_sprite("sprites/olhos/abertos.png"),
        "fechados": carregar_sprite("sprites/olhos/fechados.png")
    }
}

skins_equipadas = {
    "corpo": "skin_corpo_1",
    "cabelo": "skin_cabelo_1",
    "brasos": "skin_brasos_1",
    "pernas": "skin_pernas_1",
    "torso": "skin_torso_1"
}

# =====================
# FUNÇÕES DE STATUS
# =====================
def limitar():
    for status in pet:
        if status != "nome":
            if pet[status] > 100: pet[status] = 100
            if pet[status] < 0: pet[status] = 0

def atualizar_tela():
    fome_label.config(text=f"Fome: {pet['fome']}%")
    energia_label.config(text=f"Energia: {pet['energia']}%")
    felicidade_label.config(text=f"Felicidade: {pet['felicidade']}%")
    higiene_label.config(text=f"Higiene: {pet['higiene']}%")

def alimentar():
    pet["fome"] += 20
    limitar()
    atualizar_tela()

def dormir():
    pet["energia"] += 30
    limitar()
    atualizar_tela()

def brincar():
    pet["felicidade"] += 25
    pet["energia"] -= 10
    pet["fome"] -= 5
    limitar()
    atualizar_tela()

def banho():
    pet["higiene"] += 30
    limitar()
    atualizar_tela()

def passar_tempo():
    pet["fome"] -= random.randint(1, 3)
    pet["energia"] -= random.randint(1, 2)
    pet["felicidade"] -= random.randint(1, 2)
    pet["higiene"] -= random.randint(1, 2)
    limitar()
    atualizar_tela()

    if pet["fome"] <= 0:
        messagebox.showwarning("Aviso", "Seu pet está com muita fome!")

    janela.after(3000, passar_tempo)

# =====================
# INTERFACE PRINCIPAL (UI)
# =====================
titulo = tk.Label(janela, text=pet["nome"], font=("Arial", 24), bg="#222222", fg="white")
titulo.pack(pady=10)

fome_label = tk.Label(janela, text="", font=("Arial", 12), bg="#222222", fg="white")
fome_label.pack()
energia_label = tk.Label(janela, text="", font=("Arial", 12), bg="#222222", fg="white")
energia_label.pack()
felicidade_label = tk.Label(janela, text="", font=("Arial", 12), bg="#222222", fg="white")
felicidade_label.pack()
higiene_label = tk.Label(janela, text="", font=("Arial", 12), bg="#222222", fg="white")
higiene_label.pack(pady=(0, 10))

# CANVAS DO PET
offset_y = 0
direcao = 1
olhos_fechados = False

canvas = tk.Canvas(janela, width=400, height=220, bg="#222222", highlightthickness=0)
canvas.pack()

def atualizar_pet_visual():
    canvas.delete("all")
    y_animado = 110 + offset_y
    
    canvas.create_image(200, y_animado, image=skins["pernas"][skins_equipadas["pernas"]])
    canvas.create_image(200, y_animado, image=skins["corpo"][skins_equipadas["corpo"]])
    canvas.create_image(200, y_animado, image=skins["torso"][skins_equipadas["torso"]])
    canvas.create_image(200, y_animado, image=skins["brasos"][skins_equipadas["brasos"]])
    canvas.create_image(200, y_animado, image=skins["cabelo"][skins_equipadas["cabelo"]])
    
    olhos = skins["olhos"]["fechados"] if olhos_fechados else skins["olhos"]["abertos"]
    canvas.create_image(200, y_animado, image=olhos)

# Botões de ações do pet
for text, cmd in [("Alimentar", alimentar), ("Dormir", dormir), ("Brincar", brincar), ("Banho", banho)]:
    tk.Button(janela, text=text, font=("Arial", 11), width=18, command=cmd).pack(pady=4)

# =====================
# JANELA DE SKINS (SUBJANELA)
# =====================
janela_skins = tk.Toplevel(janela)
janela_skins.title("Guarda-Roupa")
janela_skins.geometry("300x550")

# Lista de tuplas para automatizar a criação com lambda corrigido
categorias = [
    ("Cabelos", "cabelo", "skin_cabelo_"),
    ("Corpos", "corpo", "skin_corpo_"),
    ("Braços", "brasos", "skin_brasos_"),
    ("Pernas", "pernas", "skin_pernas_"),
    ("Torsos", "torso", "skin_torso_")
]

for label_txt, chave_cat, prefixo in categorias:
    tk.Label(janela_skins, text=label_txt, font=("Arial", 10, "bold")).pack(pady=(8, 2))
    frame_botoes = tk.Frame(janela_skins)
    frame_botoes.pack()
    for i in range(1, 4):
        # n=i injeta fixamente o valor atual do loop na lambda
        tk.Button(
            frame_botoes, 
            text=f"{i}", 
            width=5,
            command=lambda c=chave_cat, p=prefixo, n=i: equipar_skin(c, f"{p}{n}")
        ).pack(side=tk.LEFT, padx=3)

# =====================
# ANIMAÇÕES & SEGUNDO PLANO
# =====================
def animar_idle():
    global offset_y, direcao
    offset_y += direcao
    if offset_y > 5: direcao = -1
    if offset_y < -5: direcao = 1
    atualizar_pet_visual()
    janela.after(120, animar_idle)

def piscar():
    global olhos_fechados
    olhos_fechados = True
    atualizar_pet_visual()
    janela.after(150, abrir_olhos)

def abrir_olhos():
    global olhos_fechados
    olhos_fechados = False
    atualizar_pet_visual()
    janela.after(random.randint(2000, 5000), piscar)

# =====================
# INICIALIZAÇÃO
# =====================
atualizar_tela()
atualizar_pet_visual()
passar_tempo()
animar_idle()
abrir_olhos()

janela.mainloop()
